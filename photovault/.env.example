# PhotoVault Configuration
# Copy this file to .env and customize the values

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_USER=photovault
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=photovault
DB_PORT=5432

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_PORT=6379

# ===========================================
# SECURITY
# ===========================================
# Generate a secure key: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional override (defaults to SECRET_KEY):
# JWT_SECRET_KEY=

# ===========================================
# ADMIN USER
# ===========================================
# This user will be created automatically on first startup
ADMIN_EMAIL=admin@photovault.app
ADMIN_PASSWORD=admin123

# ===========================================
# EMAIL CONFIGURATION (Optional)
# ===========================================
# Enable/disable email verification requirement
EMAIL_VERIFICATION_REQUIRED=true

# Local development (default docker-compose): Mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025

# Production example (Gmail SMTP requires an app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
#
# TLS options:
# - SMTP_USE_TLS=true for implicit TLS (usually port 465)
# - SMTP_STARTTLS=true/false to force STARTTLS on/off (port 587 often needs true)
# SMTP_USE_TLS=false
# SMTP_STARTTLS=

SMTP_FROM_EMAIL=noreply@photovault.app

# ===========================================
# NAS CONFIGURATION
# ===========================================
# Path to your NAS mount point on the host system
# For Synology: /volume1/photos or similar
NAS_PATH=./data/nas

# ===========================================
# PORTS
# ===========================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
MAILPIT_UI_PORT=8025

# ===========================================
# URLS
# ===========================================
# Frontend URL (used for email links)
FRONTEND_URL=http://localhost:3000
# API URL for frontend to connect to backend
VITE_API_URL=http://localhost:8000

# ===========================================
# AI FEATURES
# ===========================================
# Enable/disable AI features (all run locally)
FACE_RECOGNITION_ENABLED=true
CLIP_ENABLED=true
YOLO_ENABLED=true

# ===========================================
# SYNOLOGY NAS SMB CONFIGURATION (Optional)
# ===========================================
# If mounting NAS via SMB instead of direct path
# SMB_SERVER=192.168.1.100
# SMB_SHARE=photos
# SMB_USERNAME=your_nas_user
# SMB_PASSWORD=your_nas_password
# SMB_DOMAIN=WORKGROUP
