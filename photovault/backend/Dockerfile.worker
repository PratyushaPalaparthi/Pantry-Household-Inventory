# Worker Dockerfile - Optimized for AI processing
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies including dlib requirements
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libpq-dev \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    libopenblas-dev \
    liblapack-dev \
    ffmpeg \
    libmagic1 \
    cifs-utils \
    wget \
    bzip2 \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    printf "cmake<4\n" > /tmp/build-constraints.txt && \
    pip install --no-cache-dir --build-constraint /tmp/build-constraints.txt -r requirements.txt && \
    rm -f /tmp/build-constraints.txt

# Download dlib face recognition model
RUN mkdir -p /root/.cache/dlib && \
    wget -q https://dlib.net/files/shape_predictor_68_face_landmarks.dat.bz2 -P /tmp && \
    bunzip2 /tmp/shape_predictor_68_face_landmarks.dat.bz2 && \
    mv /tmp/shape_predictor_68_face_landmarks.dat /root/.cache/dlib/ && \
    wget -q https://dlib.net/files/dlib_face_recognition_resnet_model_v1.dat.bz2 -P /tmp && \
    bunzip2 /tmp/dlib_face_recognition_resnet_model_v1.dat.bz2 && \
    mv /tmp/dlib_face_recognition_resnet_model_v1.dat /root/.cache/dlib/

# Pre-download AI models.
# yolov8s (small) — better accuracy than nano with modest extra compute.
RUN python -c "from ultralytics import YOLO; YOLO('yolov8s.pt')"
# ViT-B-16 — better CLIP accuracy than ViT-B-32 with the same 512-D embedding space.
RUN python -c "import open_clip; open_clip.create_model_and_transforms('ViT-B-16', pretrained='openai', device='cpu')"
# Warm up pillow-heif so HEIC support is available immediately
RUN python -c "from pillow_heif import register_heif_opener; register_heif_opener()"

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p /media /thumbnails /nas

# Run as non-root user for security
RUN useradd -m -u 1000 worker
RUN chown -R worker:worker /app /media /thumbnails
USER worker

# Default command (can be overridden)
CMD ["celery", "-A", "app.workers.celery_app", "worker", "--loglevel=info"]
