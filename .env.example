# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Used directly by `npm run dev` / `prisma migrate dev` on your machine.
DATABASE_URL="postgresql://inventory:changeme@localhost:5432/inventory?schema=public"
# Used by docker-compose.yml to configure the "db" service and to build the
# app container's DATABASE_URL (which points at "db", not "localhost").
POSTGRES_PASSWORD="changeme"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="changeme-generate-a-real-32-byte-secret"
# Public URL the app is served at, used by NextAuth for callbacks and for
# deciding whether to issue __Secure- cookies. This MUST be the exact public
# origin once you expose the app, e.g. https://pantry.example.com — leaving it
# as localhost breaks login from anywhere else.
NEXTAUTH_URL="http://localhost:3000"

# Number of reverse proxies in front of the app. 1 = your own proxy only;
# 2 = a CDN or tunnel (Cloudflare, ngrok) in front of that proxy. This decides
# which X-Forwarded-For entry the login rate limiter trusts, so setting it too
# high lets a client forge its apparent IP and evade the lockout.
TRUSTED_PROXY_HOPS="1"

# --- AI provider ---
# "claude" or "ollama"
AI_PROVIDER="ollama"

# Used when AI_PROVIDER=claude
ANTHROPIC_API_KEY=""
# Anthropic's OpenAI-compatible endpoint + model
AI_CLAUDE_BASE_URL="https://api.anthropic.com/v1"
AI_CLAUDE_MODEL="claude-sonnet-5"

# Used when AI_PROVIDER=ollama
# Base URL of Ollama's OpenAI-compatible endpoint. docker-compose overrides this
# to http://ollama:11434/v1 for the app container; this value is for running
# `npm run dev` on the host against the compose Ollama (port 11434 published).
AI_OLLAMA_BASE_URL="http://localhost:11434/v1"

# Text model: receipt parsing, natural-language add/update, natural-language
# search. Needs to follow JSON instructions and cope with multilingual,
# heavily-abbreviated receipt text.
#
# Containers get no GPU on macOS (and usually not on a NAS), so this runs on CPU.
# Bigger = better parsing, slower replies:
#   qwen2.5:7b    ~4.7 GB default — ~15s per receipt on CPU. Measured against
#                         Vietnamese/Spanish/abbreviated receipts it translated
#                         correctly and, where genuinely unsure, kept the original
#                         text instead of inventing a product.
#   qwen2.5:14b   ~9 GB   better still, roughly 2x slower again
#
# Do NOT drop to qwen2.5:3b. It is faster but it hallucinated wrong products in
# testing ("DAU HU"/tofu came back as "Fish Sauce", "BAI CAI"/bok choy as "Pork
# Liver"). Wrong line items silently corrupt your stock counts and price history,
# which is worse than a slow parse.
# Change it, then `docker compose up -d` to pull the new model automatically.
AI_OLLAMA_MODEL="qwen2.5:7b"

# Vision model, used only by photo-to-item. Most local text models can't see
# images at all, so this is separate — a text-only model would ignore the photo
# and invent an answer.
#   llava:7b      ~4.7 GB default — ~10s, returns the required JSON shape reliably
#   llama3.2-vision:11b  ~8 GB  better at reading small print off packaging
#
# Avoid moondream: it reads images well but ignores the output format, and in
# testing it fell into a repetition loop that produced unparseable JSON.
AI_OLLAMA_VISION_MODEL="llava:7b"

# --- OCR ---
# Tesseract language codes, "+"-joined. Add more if your receipts mix in
# other scripts, e.g. "eng+vie+chi_sim" for English+Vietnamese+Chinese.
OCR_LANGUAGES="eng"

# --- File storage ---
# Local path (inside the container) where uploaded photos/receipts are stored.
# Not under /public — files are only reachable via the authenticated /api/files route.
UPLOAD_DIR="./storage/uploads"

# --- Cloudflare Tunnel (optional) ---
# Only needed if you publish the app with `docker compose --profile tunnel up -d`.
# Token from the Zero Trust dashboard when you create a tunnel. Leave empty
# otherwise; the tunnel container simply never starts.
CF_TUNNEL_TOKEN=""
