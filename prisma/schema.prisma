generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7 removed `url` from the schema. The connection string now reaches
  // the client through a driver adapter (see src/lib/prisma.ts) and reaches the
  // migrate CLI through prisma.config.ts.
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items         Item[]
  shoppingItems ShoppingListEntry[]
  receipts      Receipt[]
  uploads       Upload[]
}

// Records who saved each uploaded file. Needed because a file can exist before
// it's attached to an Item or Receipt (e.g. a barcode lookup fetches a product
// image for preview), and /api/files must still be able to prove ownership.
model Upload {
  filename  String   @id
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Item {
  id                String    @id @default(cuid())
  userId            String
  name              String
  category          String
  unitOfMeasure     String
  lowStockThreshold Float     @default(0)
  imageUrl          String?
  notes             String?
  brand             String?
  preferredStore    String?
  expirationDate    DateTime?
  barcode           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations     ItemLocation[]
  priceHistory  PriceHistory[]
  shoppingLinks ShoppingListEntry[]
  tags          ItemTag[]
  usageEvents   UsageEvent[]

  @@index([userId])
  @@index([userId, category])
  @@index([barcode])
}

model ItemLocation {
  id           String @id @default(cuid())
  itemId       String
  locationName String
  quantity     Float  @default(0)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  items ItemTag[]
}

model ItemTag {
  itemId String
  tagId  String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
}

model Store {
  id   String @id @default(cuid())
  name String @unique

  priceHistory PriceHistory[]
}

model PriceHistory {
  id                String   @id @default(cuid())
  itemId            String
  storeId           String
  price             Float
  date              DateTime @default(now())
  quantityPurchased Float    @default(1)
  unitOfMeasure     String

  item  Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([itemId, date])
}

model UsageEvent {
  id        String   @id @default(cuid())
  itemId    String
  delta     Float
  reason    String
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

model ShoppingListEntry {
  id            String   @id @default(cuid())
  userId        String
  text          String
  unitOfMeasure String?
  isManual      Boolean  @default(true)
  isDone        Boolean  @default(false)
  linkedItemId  String?
  storeHint     String?
  createdAt     DateTime @default(now())

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedItem Item? @relation(fields: [linkedItemId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Receipt {
  id           String   @id @default(cuid())
  userId       String
  imageUrl     String
  uploadedAt   DateTime @default(now())
  parsedStatus String   @default("pending")
  storeName    String?
  rawOcrText   String?

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines ReceiptLine[]

  @@index([userId])
}

model ReceiptLine {
  id            String  @id @default(cuid())
  receiptId     String
  rawText       String
  parsedName    String?
  quantity      Float?
  unitOfMeasure String?
  price         Float?
  matchedItemId String?
  status        String  @default("unresolved")

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}
